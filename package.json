{
  "name": "audit-sluice",
  "version": "0.1.4",
  "description": "代码审计 CLI：规则驱动 + AST/正则检查 + 评分 + 豁免（零配置可跑，输出单行 JSON 契约）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cli": "./cli.mjs",
    "./manifest": "./lib/manifest.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "audit-sluice": "./cli.mjs"
  },
  "files": [
    "lib",
    "cli.mjs",
    "scripts/scan-file-io.mjs",
    "scripts/doc-tree.mjs",
    "scripts/doc-func.mjs",
    "scripts/audit-ext",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit": "node cli.mjs --scope full --json",
    "test": "node --test test/*.mjs",
    "doc-tree": "node scripts/doc-tree.mjs apply",
    "doc-func": "node scripts/doc-func.mjs apply"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "4.1.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {}
}
